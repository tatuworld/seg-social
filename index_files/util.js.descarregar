const copyText = function (e, id) {
    var textArea = document.createElement("textarea");
    textArea.value = e.className;

    document.body.appendChild(textArea);
    textArea.select();

    document.execCommand("copy");
    document.body.removeChild(textArea);


    const label = document.getElementById(id);
    const div = document.createElement("div");
    label.appendChild(div);
    div.textContent = "Copiado";

    setTimeout(function () {
        label.removeChild(div)
    }, 1000);
}


NodeList.prototype.toArray = function (fn) {
    const array = [];
    for (let i = 0; i < this.length; i++) {
        array.push(this[i]);
    }
    return array;
}


const frawPathway = document.getElementById("frawPathway");

if (frawPathway) {

    const mobileBreakPoint = 766;

    const unselect = function (event) {
        event.target.parentNode.parentNode.classList.remove("selecionado");
        event.stopPropagation();
    }

    const hasWord = function (array, palavra) {
        return array.filter(function (element) {
            return element === palavra
        }).length > 0;
    }

    const matchID = function (palavra) {
        return palavra.match("[^A][0-9]{3}");
    }

    const openMenu = function () {
        if (hasWord(pathnames, "browse")) {
            const menu = pathnames.filter(matchID);
            if (menu.length > 0) {
                document.getElementById("P-" + menu[0]).classList.add("selecionado");
            }
        }
    }

    const stopEventPropagation = function (event) {
        event.stopPropagation();
    }

    const pathnames = window.location.pathname.split("/");

    const isMobile = function () {
        return window.innerWidth < mobileBreakPoint
    };

    const halfElement = function (e) {
        e.style.width = "50%"
    }
    const fullElement = function (e) {
        e.style.width = "100%"
    }

    const selectAllMenuItemNivel1 = function () {
        return document.querySelectorAll("nav.pathway .menu.nivel-1 > .item").toArray();
    }

    const selectAllMenuItemFolha = function () {
        return document.querySelectorAll("nav.pathway .item .folha").toArray();
    }

    const hasSelectedMenuItemArvore = function () {
        return document.querySelectorAll("nav.pathway .nivel-1 .item.arvore.selecionado").length > 0;
    }

    const observerMenuChanges = function () {
        selectAllMenuItemNivel1().forEach(hasSelectedMenuItemArvore() && !isMobile() ? halfElement : fullElement);
    }

    const bindObserveMenuItemChanges = function (menu) {
        mut.observe(menu, {"attributes": true})
    }

    const disableAutoCloseWhenFolhaIsClicked = function () {
        selectAllMenuItemFolha().forEach(function (e) {
            e.addEventListener("click", stopEventPropagation)
        });
    }

    const getNameFirstElement = function () {
        return document.querySelector("nav.pathway .item.home").innerText;
    }

    const createLinkBack = function () {

        document.querySelectorAll("nav.pathway .menu").toArray().filter(function (menu) {
            return menu.children.length > 0
        }).forEach(function (e) {

            const navegacao = document.createElement("a");

            var parent = e.parentNode;
            while (parent !== null && parent.nodeName !== "UL") {
                parent = parent.parentNode;
            }

            if (parent) {
                var label = parent.dataset.header;
                navegacao.innerText = label ? label : getNameFirstElement();
                navegacao.classList.add("navegacao-pathway")
                navegacao.addEventListener("click", unselect);
                e.insertBefore(navegacao, e.firstChild);
            }

        })

    }

    const mut = new MutationObserver(observerMenuChanges);
    selectAllMenuItemNivel1().forEach(bindObserveMenuItemChanges);


    openMenu();
    disableAutoCloseWhenFolhaIsClicked();
    createLinkBack();
}


(function () {
    $("nav.horizontal .menu.nivel-1 > .item.arvore").click(
            function () {
                $(this).addClass("selecionado");
            }
    );

    $("nav.horizontal i.voltar").click(
            function () {
                let parent = $(this).parent();

                while (!parent.hasClass("selecionado")) {
                    parent = parent.parent();
                }
                parent.removeClass("selecionado");
                event.stopPropagation();
            }
    )
    
    $('.ui-selectonemenu-filter.ui-inputfield.ui-inputtext').on('keydown', function(e){
        if(e.keyCode == 27){ // ESC
             id = $(this).attr('id');
             main_id = id.split('_');
             $(document.getElementById(main_id[0]+"_focus")).focus();
        }
     });

}());


const uxdsLeftTabScroll = function (widgetVar) {

    const widgetComponent = PF(widgetVar);
    widgetComponent.navcrollerLeft.off("click.tabview");
    widgetComponent.navcrollerRight.off("click.tabview");

    let clickCount = -1;
    const array = widgetComponent.navContainer.find("li");

    widgetComponent.navcrollerRight.on("click", function () {

        clickCount++;
        widgetComponent.scroll(width($(array[clickCount]), clickCount) * -1);

    });

    widgetComponent.navcrollerLeft.on("click", function () {

        widgetComponent.scroll(width($(array[clickCount]), clickCount));
        clickCount--;

    });

    function width(li, clickCount) {

        let innerWidth = $(li).innerWidth();
        innerWidth -= clickCount == 0 ? 38 : -5;
        return innerWidth;

    }

}

const uxdsTabScroll = function (widgetVar) {

    const widgetComponent = PF(widgetVar);
    widgetComponent.navcrollerLeft.off("click.tabview");
    widgetComponent.navcrollerRight.off("click.tabview");

    let index = 0;

    const navs = []

    widgetComponent.navcrollerLeft.on("click", function () {
        const navC = widgetComponent.navContainer
        const left = parseInt(navC.css("margin-left"))
        const popped = navs.pop()
        if (left * -1 < popped) {
            widgetComponent.scroll(left * -1)
        } else {
            widgetComponent.scroll(popped)
        }
        index = navs.length
    })


    widgetComponent.navcrollerRight.on("click", function () {

        const innerWidth = widgetComponent.navscroller.innerWidth()
        const navC = widgetComponent.navContainer
        const lis = navC.find("li")
        let tam = 0

        while (tam < innerWidth && index < lis.size()) {
            tam += $(lis[index]).outerWidth()
            index++
        }

        navs.push($(lis[index - 1]).outerWidth() + widgetComponent.navcrollerRight.outerWidth())
        widgetComponent.scroll($(lis[index - 1]).outerWidth() * -1)
    })

    widgetComponent.navscroller.find("li").on("click", function () {

        const tabSelected = widgetComponent.navContainer.find(".ui-tabs-selected");
        const tabSelectedWidth = tabSelected.outerWidth();
        const buttonWidth = widgetComponent.navcrollerRight.outerWidth();
        const widthPosition = tabSelected.position().left + tabSelectedWidth + buttonWidth;

        const navScrollerWidth = widgetComponent.navscroller.innerWidth();

        if (widthPosition > navScrollerWidth) {
            widgetComponent.navcrollerRight.click();
            return;
        }

        const tabButtonWidth = tabSelectedWidth + widgetComponent.navcrollerLeft.outerWidth();

        if (tabButtonWidth > widthPosition)
            widgetComponent.navcrollerLeft.click();

    })


}

const removeAbbreviationsTitleAttribute = function () {
    let tooltipAbbreviationElements = document.querySelectorAll("tbody > tr > td > .ui-ci-outputtext-descricaolonga > abbr");

    for (let i = 0; i < tooltipAbbreviationElements.length; i++) {
        tooltipAbbreviationElements[i].removeAttribute("title");
    }
};

const pageElement = document.querySelector("#page");

if (pageElement !== null) {
    pageElement.addEventListener("click", function () {
        let tooltipAbbreviationElements = document.querySelectorAll("tbody > tr > td > .ui-ci-outputtext-descricaolonga > abbr");

        if (tooltipAbbreviationElements.length !== 0) {
            for (let i = 0; i < tooltipAbbreviationElements.length; i++) {
                tooltipAbbreviationElements[i].addEventListener("mouseover", function () {
                    removeAbbreviationsTitleAttribute();
                });
            }
        }

        return;
    });
}


