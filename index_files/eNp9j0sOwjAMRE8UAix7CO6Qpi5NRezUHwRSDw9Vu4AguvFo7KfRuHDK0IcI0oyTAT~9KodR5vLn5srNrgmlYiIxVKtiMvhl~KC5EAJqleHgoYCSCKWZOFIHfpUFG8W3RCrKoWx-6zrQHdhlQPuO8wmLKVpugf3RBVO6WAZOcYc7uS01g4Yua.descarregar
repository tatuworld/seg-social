function handleStateStore(){
    const dswid = '#{frawMicroFEController.getWindowId()}';
	const ctxPath  = '#{frawMicroFEController.contextPath()}';

	const frawStoreState = {

	getSwid: function(){
    return dswid;
	},

	initial: function(){
	    return fetch("/" + ctxPath + "/rest/fraw/store/state/" + dswid, {
	        method: "DELETE",
	        headers: {
	            "Accept": "application/json"
			}
		}).then((response) => {
			if(response.ok){
			    return response.json();
			}
			    throw response;
		})},
			sync: function(state){
			    return fetch("/" + ctxPath + "/rest/fraw/store/state/" + dswid, {
			    method: "PUT",
			    body: JSON.stringify(state),
			    headers: {
			        "Accept": "application/json",
			        "Content-Type": "application/json"
			    }
			}).then((response) => {
			    if(response.ok){
			        return response.json();
			    }
			    throw response;
			})
			}
			};

			const frawStoreStateEvt = new CustomEvent("fram:store:state:change", {
			detail: {
			storage: frawStoreState,
			swid: dswid
			}
			});

			window.dispatchEvent(frawStoreStateEvt);
}

window.addEventListener("fram:store:ready", () => {
    handleStateStore()
});


