function FrawAsyncHandler() {
	this.endSocketListeners = [];
	this.addEndSocketListener = function (listener) {
		this.endSocketListeners.push(listener);
	};
}

var frawAsyncHandler = new FrawAsyncHandler();

function frawHandlePushMessage(notification) {
	if (notification.poison) {
		if (frawAsyncHandler.endSocketListeners) {
			while (frawAsyncHandler.endSocketListeners.length > 0) {
				try {
					frawAsyncHandler.endSocketListeners.pop().call(null,
						notification);
				} catch (e) {
					console.log(e);
				}
			}
		}

		frawDisconnectPushSocket();
		return;
	}

	if (notification.severity) {
		var facesMessage = {
			detail: notification.detail,
			severity: notification.severity,
			summary: notification.summary
		};

		PF('frawGeneralGrowl').show([facesMessage]);
	}

	if (notification.javascriptHandler) {
		var fnJavascriptHandler = window[notification.javascriptHandler];
		if (typeof fnJavascriptHandler === "function") {

			if (notification.handlerJsonObject) {
				fnJavascriptHandler.apply(null,
					[notification.handlerJsonObject]);
			} else {
				fnJavascriptHandler.apply(null, [notification]);
			}
		}
	}
}

function frawHandlePushMessageError(problem) {
	console.log(problem);
}

function frawConnectPushSocket() {
    var frawAsyncSocket = PF('frawAsyncSocket');
	if (frawAsyncSocket) {
		if (frawAsyncSocket.connection
			&& frawAsyncSocket.connection.response
			&& frawAsyncSocket.connection.response.state != 'closed') {
			return;
		}

		frawAsyncSocket.connect();
	}
}

function frawDisconnectPushSocket() {
    var frawAsyncSocket = PF('frawAsyncSocket');
	if (frawAsyncSocket) {
		if (frawAsyncSocket.connection
			&& frawAsyncSocket.connection.response
			&& frawAsyncSocket.connection.response.state != 'closed') {
			frawAsyncSocket.disconnect();
		}
	}
}

$(window).unload(function () {
	frawDisconnectPushSocket();
});

$(".dismissable").click(function () {
	$(this).fadeOut("fast");
});

$(".auto.dismissable").delay(10000).fadeOut("fast");

function FrawIdleTimer() {
	this.timeout = 0;
	this.timer = null;
	this.stop = function () {
		if (this.timer && this.timer != null) {
			window.clearTimeout(this.timer);
		}
	}
	this.start = function (newTimeout) {
		this.stop();
		if (newTimeout) {
			this.timeout = newTimeout;
		}
		if (this.timeout > 0) {
			this.timer = window.setTimeout(this.frawKeepAliveTimeout,
				this.timeout);
		}
	}
	this.frawKeepAliveTimeout = function () {
		frawKeepAlive();
	}
}

var frawIdleTimeout = new FrawIdleTimer();

/* Smooth scroll */
$('a[href*=#]:not([href=#])').click(function () {
	var target = $($(this).attr("href").replace(/:/g, '\\:'));

	$('html,body').animate({
		scrollTop: target.offset().top
	}, 1000);
});

/* Show go to top */
(function goTopTop(selector, ratio, timeout) {
	var timerID;
	var jqObject = $(selector);
	var jqWindow = $(window);

	function checkScroll() {
		var scroll = jqWindow.scrollTop();
		var vpHeight = jqWindow.height() * ratio;

		if (scroll > vpHeight) {
			jqObject.removeClass('ui-helper-hidden');
		} else {
			jqObject.addClass('ui-helper-hidden');
		}
	}

	jqWindow.scroll(function () {
		window.clearTimeout(timerID);
		timerID = window.setTimeout(checkScroll, timeout);
	});

	checkScroll();
}('#backToTop', 0.5, 250));

/* Algumas funcionalidades que so estao disponoveis no ES6 */
(function ES6Polyfills() {
	if (!String.prototype.startsWith) {
		String.prototype.startsWith = function (searchString, position) {
			position = position || 0;
			return this.indexOf(searchString, position) === position;
		};
	}

	if (typeof Object.create != 'function') {
		Object.create = (function (undefined) {
			var Temp = function () {
			};
			return function (prototype, propertiesObject) {
				if (prototype !== Object(prototype)) {
					throw TypeError('Argument must be an object, or null');
				}
				Temp.prototype = prototype || {};
				var result = new Temp();
				Temp.prototype = null;
				if (propertiesObject !== undefined) {
					Object.defineProperties(result, propertiesObject);
				}

				// to imitate the case of Object.create(null)
				if (prototype === null) {
					result.__proto__ = null;
				}
				return result;
			};
		})();
	}

	if (typeof Object.assign != 'function') {
		Object.assign = function (target, varArgs) { // .length of function is 2
			'use strict';
			if (target == null) { // TypeError if undefined or null
				throw new TypeError(
					'Cannot convert undefined or null to object');
			}

			var to = Object(target);

			for (var index = 1; index < arguments.length; index++) {
				var nextSource = arguments[index];

				if (nextSource != null) { // Skip over if undefined or null
					for (var nextKey in nextSource) {
						// Avoid bugs when hasOwnProperty is shadowed
						if (Object.prototype.hasOwnProperty.call(nextSource,
							nextKey)) {
							to[nextKey] = nextSource[nextKey];
						}
					}
				}
			}
			return to;
		};
	}
}());

/* Add functionaly to primefaces */
(function PFFixes(PF) {
	if (!PF) {
		return;
	}

	/* TODO: externalizar esta funcao para utils */
	/**
	 * Verifica se um dado evento e considerado evento de rato (por outras
	 * palavras, se for um evento que retorna coordenadas, tal como um rato).
	 * 
	 * @param {(Event |
	 *            String)} event O evento a verificar
	 * @returns {Boolean} verdadeiro se o evento obeceder ao criterio
	 */
	function isMouseEvent(event) {
		var events = ['mouse', 'click', 'touch'];
		var ev;

		if (event.type) {
			ev = event.type;
		} else {
			ev = event;
		}

		return ev ? events.some(function (e) {
			return ev.startsWith(e);
		}) : false;
	}

	/**
	 * Expande ou encolhe determinada linha de uma DataTable
	 * 
	 * @param {Integer}
	 *            number numero de linha expandir/encolher
	 */
	PF.widget.DataTable.prototype.toggleRowExpansion = function (number) {
		/**
		 * Simula um objecto jQuery, de modo a retornar exatamente a linha que
		 * se pretende que seja expandida ou encolhida
		 * 
		 * @param {Primefaces.widget.DataTable}
		 *            table a tabela
		 * @param {Integer}
		 *            n numero da linha (a pimeira linha e 0)
		 * @returns {$} um objecto jQuery que simula um rowExpander
		 */
		function fakeExpander(table, n, rows) {
			return {
				/**
				 * Em vez de retornar o closest, "engana-se" o toggleExpansion
				 * do PF, para retornar a row que queremos expandir
				 * 
				 * @returns {$} row a ser expandido encolhido
				 */
				closest: function () {
					if (rows == -1) {
						return table
							.find(
								'.ui-widget-content > tr:not(".ui-expanded-row-content")')
							.eq(n);
					} else {
						return table
							.find(
								'.ui-widget-content > tr:not(".ui-expanded-row-content")')
							.eq(n % rows);
					}
				},
				/**
				 * Dummy
				 */
				removeClass: function () {
					return this;
				},
				/**
				 * Dummy
				 */
				addClass: function () {
					return this;
				},

				hasClass: function (className) {
					if (className == "ui-icon") {
						return true;
					} else if (className == "ui-icon-circle-triangle-s") {
						var row = this.closest('tr');

						return row.hasClass('ui-expanded-row');
					}
				},

				children: function (selector) {
					return [];
				},

				/**
				 * Dummy
				 */
				attr: function (attrName, value) {

				}
			};
		}

		/* O toggleExpansion precisa disto */
		if (!this.expansionProcess) {
			this.expansionProcess = [];
		}

		/* Chama a expansao para a linha nnmero n */
		Object.getPrototypeOf(this).toggleExpansion.call(this, fakeExpander(
			this.getJQ(), number,
			typeof this.getPaginator() !== 'undefined' ? this
				.getPaginator().cfg.rows : -1));
	};

	/* Funcoes "overriden" do Tooltip para simular um super() (como em Java) */
	var TooltipMethods = {
		bindTaget: PF.widget.Tooltip.prototype.bindTarget,
		align: PF.widget.Tooltip.prototype.align,
		show: PF.widget.Tooltip.prototype.show
	};

	/**
	 * Alinha a tooltip, tendo em conta a posicao do rato, caso haja um evento
	 * de rato
	 * 
	 * @override
	 * @param {Event}
	 *            e O evento
	 */
	PF.widget.Tooltip.prototype.align = function (e) {
		if (e && isMouseEvent(e)) {
			this.jq.css({
				'left': e.pageX + 'px',
				'top': (e.pageY + 15) + 'px'
			});
		} else {
			TooltipMethods.align.call(this);
		}
	};

	/**
	 * Faz o rebinding dos eventos nos elementos cujo showEvent sejam
	 * relacionados com o rato
	 * 
	 * @override
	 */
	PF.widget.Tooltip.prototype.bindTarget = function () {
		TooltipMethods.bindTaget.call(this);
		var showEvent = this.cfg.showEvent;
		if (showEvent && isMouseEvent(showEvent)) {
			var $this = this;
			this.target.off(showEvent).on(showEvent, function (e) {
				$this.show(e);
			});
		}
	};

	/*
	 * Funcao show() re-escrita de modo a que que consiga pasar o objecto de
	 * evento para o align()
	 */
	/**
	 * Mostra o tooltip, dando conhecimento ao memodo align() de qual foi o
	 * evento
	 * 
	 * @param {Event}
	 *            e evento recebido do event handler
	 */
	PF.widget.Tooltip.prototype.show = function (e) {
		if (e && isMouseEvent(e)) {
			var _self = this;
			window.clearTimeout(this.timeout);
			this.timeout = window.setTimeout(function () {
				_self.align(e);
				_self.jq.show(_self.cfg.showEffect, {}, 400);
			}, 150);
		} else {
			TooltipMethods.show.call(this);
		}
	};

	var CalendarMethods = {
		init: PrimeFaces.widget.Calendar.prototype.init
	}

	PrimeFaces.widget.Calendar.prototype.init = function (cfg) {
		if (cfg.dateFormat.indexOf('d') == -1) {
			cfg.drawDays = false;

			cfg.onChangeMonthYear = function (year, month, inst) {
				var thisFormat = inst.settings.dateFormat;
				var d = jQuery.datepicker.formatDate(thisFormat, new Date(year,
					month - 1, 1));

				inst.input.val(d);
				inst.input.change();
			};

			cfg.preShow = function (input, inst) {
				if ((datestr = $(input).val()).length > 0) {
					var format = inst.settings.dateFormat;
					// jQuery datepicker.parseDate requires day in the date
					// format
					if (inst.settings.mask == '9999'){
						format = "yy";
						// For year-only format, don't append -dd and use different date string
						datestr = datestr; // Keep original year value
					} else {
						format = format + "-dd";
						datestr = datestr + "-01";
					}

					//Solution to solve problem in invalid months
					var dateParsed;

					try {
						dateParsed = $.datepicker.parseDate(format, datestr);
					} catch (e) {
						if (inst.settings.mask == '9999') {
							// For year-only, create a Date object directly instead of parsing again
							var yearValue = parseInt(datestr);
							if (!isNaN(yearValue) && yearValue > 1000 && yearValue < 2200) {
								dateParsed = new Date(yearValue, 0, 1);
							} else {
								var currentYear = new Date().getFullYear();
								dateParsed = new Date(currentYear, 0, 1);
							}
						} else {
							datestr = new Date().toISOString().slice(0, 10);
							dateParsed = $.datepicker.parseDate(format, datestr);
						}
					}


					if (dateParsed != null) {
						var offsetMinutes = dateParsed.getTimezoneOffset();
						var time = dateParsed.getTime()
							- (offsetMinutes * 60 * 1000);
						var newDate = new Date(time);

						$(input).datepicker('option', 'defaultDate', newDate);
						$(input).datepicker('setDate', newDate);

						// HACK: Restaura o icon do calendario, mas causa um
						// ligeiro "pisca-pisca".
						// Ver se nao existe melhor solucao.
						var button = $(input).next();
						button.addClass('ui-button ui-widget ui-state-default ui-corner-all ui-button-icon-only');
						button.empty();
					}
				}
			};

		} else {
			cfg.drawDays = true;

			cfg.onChangeMonthYear = function (year, month, inst) {
				var thisFormat = inst.settings.dateFormat;
				var currentDay = inst.selectedDay;
				var dateCalculated = new Date(year, month - 1, currentDay);

				while (dateCalculated.getMonth() !== month - 1) {
					currentDay = currentDay - 1;
					dateCalculated = new Date(year, month - 1, currentDay);
				}

				var d = $.datepicker.formatDate(thisFormat, dateCalculated);

				inst.input.val(d);
				inst.input.change();
			};

		}

		CalendarMethods.init.call(this, cfg);

		//fix inner text for calendar button
		$(".ui-calendar .ui-button-icon-only").each(function( index ) {
			$(this).attr("aria-label", "Mostrar calendário")
			$(this).children(".ui-button-text").text("Mostrar calendário");
		});
	};

	PrimeFaces.widget.Calendar.prototype.configureLocale = function () {
		var localeSettings = PrimeFaces.locales[this.cfg.locale];

		if (localeSettings) {
			if (!this.cfg.drawDays) {
				localeSettings = Object.assign(Object.create(localeSettings), {
					currentText: "Mês atual"
				});
			}

			for (var setting in localeSettings) {
				this.cfg[setting] = localeSettings[setting];
			}
		}
	};

	//bug https://github.com/primefaces/primefaces/pull/4308
	PrimeFaces.widget.OverlayPanel.prototype.refresh = function (cfg) {
		PF.widget.OverlayPanel.prototype.init.call(this, cfg);
		this.loaded = false;
	};

	//bug aria-autocomplete=listbox - nonexistent today (2024)
	PrimeFaces.widget.AutoComplete = PrimeFaces.widget.AutoComplete.extend({
		init: function(cfg) {
			this._super(cfg);
			this.input.attr("aria-autocomplete", "list");
		}
	});

	PrimeFaces.widget.Dialog = PrimeFaces.widget.Dialog.extend({
		postShow: function() {
			this._super();
			this.jq.removeAttr("aria-hidden");
		},
		onHide: function(a,b) {
			this._super(a,b);
			this.jq.removeAttr("aria-hidden");
		},
		applyARIA: function() {
			this._super();
			this.jq.removeAttr("aria-hidden");
		}
	});

	PrimeFaces.widget.SelectCheckboxMenu = PrimeFaces.widget.SelectCheckboxMenu.extend({
		renderPanel: function() {
			this._super();
			$(".ui-helper-hidden-accessible :checkbox").each(function( index ) {
				$(this).attr("aria-label", "Caixa de selecão")
			});
			if (this.cfg.filter) {
				$(".ui-selectcheckboxmenu-filter-container :text").attr("aria-label", "Pesquisa");
			}
			$("a.ui-selectcheckboxmenu-close.ui-corner-all").attr("aria-label", "Fechar caixa de opções");
		}
	});

	if(typeof PrimeFaces.widget.FileUpload !== "undefined") {
		PrimeFaces.widget.FileUpload = PrimeFaces.widget.FileUpload.extend({
			IMAGE_TYPES: /(\.|\/)(gif|jpe?g|png)$/i,
			init: function(a) {
				this._super(a);
				if (this.cfg.disabled) {
					return
				}
				this.ucfg = {};
				this.form = this.jq.closest("form");
				this.buttonBar = this.jq.children(".ui-fileupload-buttonbar");
				this.chooseButton = this.buttonBar.children(".ui-fileupload-choose");
				this.uploadButton = this.buttonBar.children(".ui-fileupload-upload");
				this.cancelButton = this.buttonBar.children(".ui-fileupload-cancel");
				this.content = this.jq.children(".ui-fileupload-content");
				this.filesTbody = this.content.find("> div.ui-fileupload-files > div");
				this.sizes = ["Bytes", "KB", "MB", "GB", "TB"];
				this.files = [];
				this.fileAddIndex = 0;
				this.cfg.invalidFileMessage = this.cfg.invalidFileMessage || "Invalid file type";
				this.cfg.invalidSizeMessage = this.cfg.invalidSizeMessage || "Invalid file size";
				this.cfg.fileLimitMessage = this.cfg.fileLimitMessage || "Maximum number of files exceeded";
				this.cfg.messageTemplate = this.cfg.messageTemplate || "{name} {size}";
				this.cfg.previewWidth = this.cfg.previewWidth || 80;
				this.uploadedFileCount = 0;
				this.renderMessages();
				this.bindEvents();
				var c = this,
					e = this.form.attr("action"),
					d = this.form.children("input[name*='javax.faces.encodedURL']");
				var b = null;
				if (d.length > 0) {
					b = 'form[action="' + e + '"]';
					e = d.val()
				}
				this.ucfg = {
					url: e,
					portletForms: b,
					paramName: this.id,
					dataType: "xml",
					dropZone: (this.cfg.dnd === false) ? null : this.jq,
					sequentialUploads: this.cfg.sequentialUploads,
					formData: function () {
						return c.createPostData()
					},
					beforeSend: function (g, f) {
						g.setRequestHeader("Faces-Request", "partial/ajax");
						g.pfSettings = f;
						g.pfArgs = {}
					},
					start: function (f) {
						if (c.cfg.onstart) {
							c.cfg.onstart.call(c)
						}
					},
					add: function (l, k) {
						c.chooseButton.removeClass("ui-state-hover ui-state-focus");
						if (c.fileAddIndex === 0) {
							c.clearMessages()
						}
						if (c.cfg.fileLimit && (c.uploadedFileCount + c.files.length + 1) > c.cfg.fileLimit) {
							c.clearMessages();
							c.showMessage({
								summary: c.cfg.fileLimitMessage
							});
							return
						}
						var h = k.files ? k.files[0] : null;
						if (h) {
							var m = c.validate(h);
							if (m) {
								c.showMessage({
									summary: m,
									filename: h.name,
									filesize: h.size
								})
							} else {
								var o = $("<div></div>").append('<div class="ui-fileupload-preview"></div>').append("<div>" + h.name + "</div>").append("<div>" + c.formatSize(h.size) + "</div>").append('<div class="ui-fileupload-progress"></div>').append('<div><button class="ui-fileupload-cancel ui-button ui-widget ui-state-default ui-corner-all ui-button-icon-only"><span class="ui-button-icon-left ui-icon ui-icon ui-icon-close"></span><span class="ui-button-text">ui-button</span></button></div>').appendTo(c.filesTbody);
								if (c.isCanvasSupported() && window.File && window.FileReader && c.IMAGE_TYPES.test(h.name)) {
									var n = $("<canvas></canvas>").appendTo(o.children("div.ui-fileupload-preview")),
										g = n.get(0).getContext("2d"),
										i = window.URL || window.webkitURL,
										f = i.createObjectURL(h),
										j = new Image();
									j.onload = function () {
										var q = null,
											p = null,
											r = 1;
										if (c.cfg.previewWidth > this.width) {
											q = this.width
										} else {
											q = c.cfg.previewWidth;
											r = c.cfg.previewWidth / this.width
										}
										var p = parseInt(this.height * r);
										n.attr({
											width: q,
											height: p
										});
										g.drawImage(j, 0, 0, q, p)
									};
									j.src = f
								}
								o.children("div.ui-fileupload-progress").append('<div class="ui-progressbar ui-widget ui-widget-content ui-corner-all" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="ui-progressbar-value ui-widget-header ui-corner-left" style="display: none; width: 0%;"></div></div>');
								h.row = o;
								h.row.data("filedata", k);
								c.files.push(h);
								if (c.cfg.auto) {
									c.upload()
								}
							}
							if (c.files.length > 0) {
								c.enableButton(c.uploadButton);
								c.enableButton(c.cancelButton)
							}
							c.fileAddIndex++;
							if (c.fileAddIndex === (k.originalFiles.length)) {
								c.fileAddIndex = 0
							}
						}
					}
				}
			},
			renderMessages: function () {
				var a = '<div class="ui-messages ui-widget ui-helper-hidden"><div class="ui-messages-error ui-corner-all"><a class="ui-messages-close" href="#" aria-label="Fechar mensagem"><span class="ui-icon ui-icon-close"></span></a><span class="ui-messages-error-icon"></span><ul></ul></div></div>';
				this.messageContainer = $(a).prependTo(this.content);
				this.messageList = this.messageContainer.find("> .ui-messages-error > ul");
				this.clearMessageLink = this.messageContainer.find("> .ui-messages-error > a.ui-messages-close")
			}
		});
	}

	PrimeFaces.widget.Spinner.prototype.addARIA = function () {
		this.input.attr("role", "spinner");
		this.input.attr("aria-multiline", false);
		if (this.input.prop("disabled")) {
			this.input.attr("aria-disabled", true)
		}
		if (this.input.prop("readonly")) {
			this.input.attr("aria-readonly", true)
		}
	}

	//bug set captcha language
	/**
     * PrimeFaces Captcha Widget
     */
    PrimeFaces.widget.Captcha = PrimeFaces.widget.BaseWidget.extend({

        init: function(cfg) {
            this._super(cfg);
            this.cfg.language = this.cfg.language||'en';
            var $this = this;

            window[this.cfg.widgetVar + '_initCallback'] = function() {
                $this.render();
            };

            $(document.body).append('<script src="https://www.google.com/recaptcha/api.js?onload=' + this.cfg.widgetVar + '_initCallback&render=explicit&hl='
                                + this.cfg.language +'" async defer>');
        },

        render: function() {
            $this = this;
            var id = this.jqId;
            var config = {
                'sitekey' : this.cfg.sitekey,
                'tabindex': this.cfg.tabindex,
                'theme': this.cfg.theme,
                'callback': new Function($this.cfg.callback),
                'expired-callback': new Function($this.cfg.expired),
                hl: this.cfg.language
            };
            switch (this.captchaType) {
                case 'CLOUDFLARE_TURNSTILE':
                    if (window.turnstile) {
                        window.turnstile.render(id,config);
                    }
                    break;
                case 'GOOGLE_RECAPTCHA':
                default:
                    if (window.grecaptcha) {
                        window.grecaptcha.render(this.jq.get(0), config);
                    }
                    break;
            }


            window[this.cfg.widgetVar + '_initCallback'] = undefined;
        },
        reset: function() {
            var captchaDiv = document.getElementById(this.id + '_initCallback');
            var captchaInput = document.getElementById(this.id + '_captchaInput');

            if (captchaInput) {
                captchaInput.value = '';
            }

            switch (this.captchaType) {
                case 'CLOUDFLARE_TURNSTILE':
                    if (window.turnstile) {
                        window.turnstile.reset(captchaDiv);
                    }
                    break;
                case 'FRIENDLY_CAPTCHA':
                    if (captchaDiv && captchaDiv.friendlyCaptcha) {
                        captchaDiv.friendlyCaptcha.reset();
                    }
                    break;
                case 'GOOGLE_RECAPTCHA':
                default:
                    if (window.grecaptcha) {
                        window.grecaptcha.reset();
                    }
                    break;
            }
        }
    });

