(function (fw) {
	// by default the warning is disable
	var frawWarnOnLeave = false;

	// attach the beforeunload event
	// $(window).on('beforeunload', function(e) {
	// if (frawWarnOnLeave){ //&& frawFormIsDirty) {
	// var e = e || window.event;
	//    	
	// var msg = 'Vai perder a informacao introduzida. Tem a certeza que
	// quer deixar esta pagina?';
	//    	
	// // For IE and Firefox prior to version 4
	// if (e) {
	// e.returnValue = msg;
	// }
	//
	// // For Safari
	// return msg;
	// }
	// });

	// on load check if the feature is activated
	$(window).load(function () {
		if ($("a[data-warn-on-leave='true']").attr('data-warn-on-leave')) {
			// activate the warning
			fw.warnOnLeave();

			// check if dirty
			// $(':input').change(function () {
			// frawFormIsDirty = true;
			// });
			// we don't do the dirty cheching anymore
		}
	});

	fw.warnOnLeave = function () {
		frawWarnOnLeave = true;
	};

	fw.dontWarnOnLeave = function () {
		frawWarnOnLeave = false;

		// Failed Ajax call
		// reactivate the feature after 10 sec if same page
		// setTimeout(function() {
		// frawWarnOnLeave = true;
		// }, 10000); -- idq pode demorar e por isso nao podemos inativar
		// automaticamente
	}

	fw.disableWarnOnLeave = function () {
		frawWarnOnLeave = false;
	}

}(window.fraw = window.fraw || {}));

function setSmallFontSize() {
	$('body').addClass("fonte-pequena");
	$('body').removeClass("fonte-media");
	$('body').removeClass("fonte-grande");
}
function setMediumFontSize() {
	$('body').removeClass("fonte-pequena");
	$('body').addClass("fonte-media");
	$('body').removeClass("fonte-grande");
}
function setLargeFontSize() {
	$('body').removeClass("fonte-pequena");
	$('body').removeClass("fonte-media");
	$('body').addClass("fonte-grande");
}


//begin Bug http://tasks.seg-social.pt/show_bug.cgi?id=50288
$('nav.links > ul.menu > li.item.arvore').keydown(function (event) {
	var keyPressed = event.which;

	if (isKeyAllowedOnSubmenu(keyPressed)) {
		var ul = $(this).find('ul');
		if (isToOpenSubmenu(keyPressed)) {
			ul.show();
			return;
		}

		if (isToCloseSubmenu(keyPressed)) {
			ul.hide();
			ul.removeAttr("style");//To not conflict with mouseover
			$(this).addClass("active"); //To keep the parent element active (with the line border when you pressed the tab button) 
			return;
		}
	}
});

$('nav.horizontal > ul.menu > li.item.arvore').keydown(function (event) {
	var keyPressed = event.which;

	if (isKeyAllowedOnSubmenu(keyPressed)) {
		var selecionado = "selecionado";
		if (isToOpenSubmenu(keyPressed)) {
			$(this).addClass(selecionado);
			return;
		}

		if (isToCloseSubmenu(keyPressed)) {
			$(this).removeClass(selecionado);
			$(this).addClass("active"); //To keep the element active (with the line border when you pressed the tab button) 
			return;
		}
	}
});

function isKeyAllowedOnSubmenu(key) {
	return [13, 27].indexOf(key) > -1;
}

function isToOpenSubmenu(key) {
	return [13].indexOf(key) > -1;
}

function isToCloseSubmenu(key) {
	return [27].indexOf(key) > -1;
}
//end Bug http://tasks.seg-social.pt/show_bug.cgi?id=50288

//bug http://tasks.seg-social.pt/show_bug.cgi?id=53761
//Solution found at https://github.com/primefaces/primefaces/issues/2448
$.extend($.ui.keyCode, {
	NUMPAD_ENTER: 108
});


