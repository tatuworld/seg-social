function updateUnreadMessageIcon(unread) {
    var iconVar = $('#frawExistsUnreadMessages');
    if(iconVar.length === 0){
        iconVar = $('#frawNoUnreadMessages');
    }
    if (unread){
       iconVar.attr("data-badge", "");
    } else {
       iconVar.removeAttr("data-badge");
    }
}


function gtag() {
	window.dataLayer = window.dataLayer || [];
	dataLayer.push(arguments);
}