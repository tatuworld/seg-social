/**
 * Fix for PrimeFaces Extensions 6.0.0 namespace mismatch in the CodeMirror widget:
 * codemirror.js calls PrimeFacesExt.widget.CodeMirror.getSuggestions but the function
 * is defined under PrimeFaces.widget.ExtCodeMirror.getSuggestions.
 * This runs in the body (after primefaces-extensions.js in head), so PrimeFacesExt is available
 * on any page that uses a PE component. The guard makes it safe everywhere else.
 */
(function fixPECodeMirrorNamespace() {
	if (typeof PrimeFacesExt === 'undefined') {
		return;
	}
	PrimeFacesExt.widget = PrimeFacesExt.widget || {};
	PrimeFacesExt.widget.CodeMirror = PrimeFacesExt.widget.CodeMirror || {};
	if (!PrimeFacesExt.widget.CodeMirror.getSuggestions) {
		PrimeFacesExt.widget.CodeMirror.getSuggestions = function (editor) {
			return {
				list: editor.widgetInstance.suggestions,
				from: { line: editor.getCursor().line, ch: editor.widgetInstance.token.start },
				to:   { line: editor.getCursor().line, ch: editor.widgetInstance.token.end }
			};
		};
	}
}());

(function Navigation() {
	if (typeof $.fn.hoverMenu !== 'function') {
		console.warn('hoverMenu plugin not loaded; navigation hover disabled.');
		return;
	}
	$("nav.horizontal").hoverMenu({
		itemSelector: ".menu.nivel-0 > .item",
		activate: function (item) {
			$(item).addClass("selecionado");
		},
		deactivate: function (item) {
			$(item).removeClass("selecionado");
		}
	});
}());

